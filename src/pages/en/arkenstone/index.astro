---
import MetaLabel from "@components/MetaLabel.astro";
import Section from "@components/Section.astro";
import { arkenstoneLanding } from "@data/arkenstone";
import { site } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";

const locale = "en";
const t = arkenstoneLanding[locale];
const firstModule = t.modules.items[0];
---

<BaseLayout
  title="The Arkenstone — pablesite.es"
  description={t.seoDescription}
  locale={locale}
  path="arkenstone/"
>
  <a class="back-link" href="/en/">{t.backLabel}</a>

  <section class="page-hero arkenstone-hero">
    <MetaLabel label="the arkenstone" />
    <h1 class="page-title">{t.hero.title}</h1>
    <p class="page-subtitle arkenstone-hero__subtitle">{t.hero.description}</p>
    <div class="pill-row arkenstone-chip-row">
      {t.hero.chips.map((chip) => <span class="pill tag--green">{chip}</span>)}
    </div>
    <div class="hero-links">
      <a class="hero-link hero-link--primary" href={site.email}
        >{t.hero.primaryCta}</a
      >
    </div>
    <div class="arkenstone-hero__visual">
      <img
        class="product-hero__image"
        src={t.hero.image}
        alt={t.hero.imageAlt}
      />
    </div>
  </section>

  <Section title={t.decisions.title} accent="real simulations">
    <div class="prose">
      <p>{t.decisions.intro}</p>
    </div>
    <div class="grid grid--two decision-grid">
      {
        t.decisions.groups.map((group) => (
          <article class="card card--accent-green decision-card">
            <h3 class="card__title">{group.title}</h3>
            <p class="card__text">{group.description}</p>
            <p class="decision-card__examples">{group.examples.join(" · ")}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section title={t.simulation.title} accent="before you accept it">
    <div class="prose">
      <p>{t.simulation.intro}</p>
    </div>
    <article
      class="card card--accent-blue simulation-summary-card simulation-summary-card--full"
    >
      <h3 class="card__title">{t.simulation.summaryTitle}</h3>
      <p class="card__text">{t.simulation.summaryDescription}</p>
      <img
        class="product-hero__image"
        src={t.simulation.image}
        alt={t.simulation.imageAlt}
      />
    </article>
    <div class="grid simulation-metrics-grid simulation-metrics-grid--four">
      {
        t.simulation.metrics.map((metric) => (
          <article class="product-mini-card simulation-metric-card">
            <span class="product-mini-card__label">{metric.title}</span>
            <strong>{metric.description}</strong>
          </article>
        ))
      }
    </div>
  </Section>

  <Section title={t.dataModes.title} accent="two valid depths">
    <div class="prose">
      <p>{t.dataModes.intro}</p>
    </div>
    <div class="grid grid--two">
      {
        t.dataModes.items.map((item) => (
          <article class="card card--accent-green mode-card">
            <h3 class="card__title">{item.title}</h3>
            <p class="card__text">{item.description}</p>
            <ul class="product-bullet-list">
              {item.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <Section title={t.modules.title} accent="product in use">
    <div class="prose">
      <p>{t.modules.intro}</p>
    </div>
    <div class="module-explorer" data-module-explorer>
      <div
        class="module-explorer__list"
        role="tablist"
        aria-label="Arkenstone modules"
      >
        {
          t.modules.items.map((item, index) => (
            <button
              class={`module-explorer__button ${index === 0 ? "module-explorer__button--active" : ""}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              data-module-button
              data-image={item.image}
              data-alt={item.imageAlt}
              data-title={item.title}
            >
              <span class="module-explorer__title">{item.title}</span>
              <span class="module-explorer__description">
                {item.description}
              </span>
            </button>
          ))
        }
      </div>

      <div class="module-explorer__visual">
        <div class="outside-card__label">Featured view</div>
        <h3 class="module-explorer__visual-title" data-module-title>
          {firstModule.title}
        </h3>
        <img
          class="product-hero__image module-explorer__image"
          src={firstModule.image}
          alt={firstModule.imageAlt}
          data-module-image
        />
      </div>
    </div>
  </Section>

  <Section title={t.improvements.title} accent="current focus">
    <div class="prose">
      <p>{t.improvements.intro}</p>
    </div>
    <div class="grid grid--two">
      {
        t.improvements.groups.map((group) => (
          <article class="card card--accent-blue improvement-card">
            <h3 class="card__title">{group.title}</h3>
            <p class="card__text">{group.description}</p>
            <ul class="product-bullet-list">
              {group.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <Section title={t.cta.title} accent="open beta">
    <div class="contact-box">
      <p>{t.cta.body}</p>
      <div class="contact-links">
        <a class="direct-link" href={site.email}>{t.cta.title}</a>
        <a class="direct-link" href={site.links.linkedin}>LinkedIn</a>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  const explorers = document.querySelectorAll("[data-module-explorer]");

  for (const explorer of explorers) {
    const buttons = explorer.querySelectorAll<HTMLButtonElement>(
      "[data-module-button]",
    );
    const image = explorer.querySelector<HTMLImageElement>(
      "[data-module-image]",
    );
    const title = explorer.querySelector<HTMLElement>("[data-module-title]");

    if (!image || !title) continue;

    for (const button of buttons) {
      button.addEventListener("click", () => {
        for (const current of buttons) {
          current.classList.remove("module-explorer__button--active");
          current.setAttribute("aria-selected", "false");
        }

        button.classList.add("module-explorer__button--active");
        button.setAttribute("aria-selected", "true");
        image.setAttribute("src", button.dataset.image ?? "");
        image.setAttribute("alt", button.dataset.alt ?? "");
        title.textContent = button.dataset.title ?? "";
      });
    }
  }
</script>
